DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
PORT=3000
JWT_SECRET=change_this_to_a_secure_random_secret_in_production
JWT_REFRESH_SECRET=change_this_to_a_different_secure_random_secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Login rate limiting (10 attempts per 10 seconds for dev/test; production defaults to 10 per 15 min)
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=10000
