# Aiven / DB TLS certificates — downloaded manually per environment, never commit.
# Keeps the certs/ folder itself (via .gitkeep) while ignoring any real certs.
certs/*.pem
certs/*.crt
certs/*.key
!certs/.gitkeep

# OpenCode or other AI temp files
.opencode/

# Ephemeral one-off DB inspection scripts (contain plaintext connection strings)
_inspect-*.tmp.js