# ============================================================
# WMS Production Environment Template (local-first)
# ============================================================
# Copy this file to `.env.production` and fill in real values.
# NEVER commit `.env.production` to Git.
#
# NOTE: NODE_ENV=production makes the backend refuse to boot when
# DATABASE_URL points at localhost / 127.0.0.1 (src\utils\env.ts,
# assertSafeEnv). In production always use a real hostname or LAN IP.
# PostgreSQL TLS is optional (DB_SSL=false by default for local).

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
NODE_ENV=production
PORT=5000

# ------------------------------------------------------------
# Database — local PostgreSQL
# ------------------------------------------------------------
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/DTC_WMS_final_db?sslmode=disable

# PostgreSQL TLS (optional). DB_SSL=false for local PostgreSQL.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA_PATH=

# PostgreSQL connection details used ONLY by the operator scripts
# (scripts\backup-db.ps1) - the application itself uses DATABASE_URL.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=DTC_WMS_final_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# ------------------------------------------------------------
# JWT Secrets
# Each must be a 32+ char random string, e.g.:
#   -join ((65..90)+(97..122)+(48..57) | Get-Random -Count 64 | ForEach-Object {[char]$_})
# ------------------------------------------------------------
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHARACTER_STRING_0a9zA_Z
JWT_REFRESH_SECRET=CHANGE_ME_TO_A_DIFFERENT_RANDOM_64_CHARACTER_STRING_0a9zA_Z
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------
# CORS - add every origin the browser will call from,
# e.g. http://localhost:5173, http://SERVER_IP. Comma-separated.
# ------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# ------------------------------------------------------------
# Rate Limiting (login)
# ------------------------------------------------------------
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000