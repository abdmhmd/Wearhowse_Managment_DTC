# ============================================================
# WMS Production Environment Configuration
# ============================================================
# Copy this file to `.env.production` and fill in real values.
# NEVER commit `.env.production` to Git.
#
# This file is the single source of truth for a Windows 11 deployment.
# The backend, migration runner and seed scripts read these values from
# the process environment. The deploy/startup scripts (scripts\*.ps1)
# load this file into the environment automatically, so you do NOT need
# to maintain a second copy inside the backend or frontend folders.
#
# IMPORTANT (read before deploying):
#   1. NODE_ENV=production makes the backend refuse to boot when
#      DATABASE_URL points at localhost / 127.0.0.1 (src\utils\env.ts,
#      assertSafeEnv). Use this server's hostname or LAN IP below.
#   2. PostgreSQL TLS is controlled by DB_SSL (see the Aiven section below):
#      DB_SSL=true = TLS enabled (required for Aiven and recommended for the
#      LAN database). When DB_SSL is unset, production keeps the legacy
#      forced-TLS behavior (rejectUnauthorized: true). DB_SSL=false opts out.

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
NODE_ENV=production
PORT=5000

# ------------------------------------------------------------
# Database
# Choose ONE deployment style (the value of DATABASE_URL is the same var):
#
#   A) Aiven for PostgreSQL (cloud) — see AIVEN_SETUP.md:
#        1. Set DATABASE_URL to your Aiven Service URI.
#        2. Download the CA cert from Aiven console → WMS_Managment_Backend\certs\ca.pem.
#        3. Uncomment DB_SSL_CA_PATH below to verify the server certificate.
#   B) Local / LAN PostgreSQL (Windows deployment):
#        Keep the DATABASE_URL + POSTGRES_* values below. Host MUST be the
#        server hostname or LAN IP — loopback is refused in production.
#        Find the hostname with:  [System.Net.Dns]::GetHostName()
# ------------------------------------------------------------
# -- Aiven example (REPLACES the DATABASE_URL below when using Aiven):
# DATABASE_URL=postgresql://postgresql://avnadmin:AVNS_tDFP5ewZavkdt8QkiAO@pg-1c761498-abd471270-8e01.c.aivencloud.com:27964/defaultdb?sslmode=require
# DATABASE_URL=postgresql://wms_user:CHANGE_ME_STRONG_PASSWORD@YOUR_SERVER_HOSTNAME:5432/DTC_WMS_final_db



# PostgreSQL TLS (Aiven / cloud).
# DB_SSL=true enables TLS. With DB_SSL_CA_PATH set, the server certificate is
# verified against the Aiven CA (certs\ca.pem). With DB_SSL_CA_PATH empty the
# connection uses TLS without certificate verification — set
# DB_SSL_REJECT_UNAUTHORIZED=false only when you must skip verification too.
# NOTE: DB_SSL_CA_PATH is commented so the local\LAN flow never reads a file
# that was not downloaded; uncomment it ONLY after storing certs\ca.pem.
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# DB_SSL_CA_PATH=./certs/ca.pem

# PostgreSQL connection details used ONLY by the operator scripts
# (scripts\backup-db.ps1) - the application itself uses DATABASE_URL.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=DTC_WMS_final_db
POSTGRES_USER=wms_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Optional: trust PostgreSQL's self-signed cert for node (backend + migrations).
# Set to the absolute path of the server cert (e.g. C:\PostgreSQL\certs\server.crt).
# Leave empty when the cert is already trusted by the OS / your CA.
NODE_EXTRA_CA_CERTS=

# ------------------------------------------------------------
# JWT Secrets
# Generate with a 64-char random string:
#   -join ((65..90)+(97..122)+(48..57) | Get-Random -Count 64 | ForEach-Object {[char]$_})
# JWT_SECRET must be >= 32 chars (hard validated at boot).
# ------------------------------------------------------------
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_ME_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------
# CORS - add the origins the browser will call from (the frontend site,
# e.g. http://SERVER_IP and http://SERVER_HOSTNAME). Comma-separated.
# ------------------------------------------------------------
CORS_ORIGINS=http://localhost,http://YOUR_SERVER_IP

# ------------------------------------------------------------
# Rate Limiting (login)
# ------------------------------------------------------------
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# ------------------------------------------------------------
# Frontend (reserved)
# The frontend currently uses a relative API base `/api` and must be
# reverse-proxied to the backend (see DEPLOYMENT_WINDOWS.md, IIS section).
# VITE_API_URL is NOT read by the current client code; it is kept here for
# future use / custom setups that serve from a different origin.
# ------------------------------------------------------------
VITE_API_URL=http://YOUR_SERVER_IP:5000/api

# ------------------------------------------------------------
# Informational only - NOT read by the application:
#   - RATE_LIMIT_MAX / RATE_LIMIT_WINDOW_MS: the general /api limiter is
#     hardcoded to 200 requests / 15 minutes in src\app.ts.
#   - LOG_LEVEL: the logger has no level configuration; set logging via the
#     PM2/capture settings instead.
#   - SEED_ADMIN_USERNAME / SEED_ADMIN_PASSWORD: scripts\seed-admin.ts and
#     scripts\reset-admin-password.ts hardcode the bootstrap account
#     admin / Admin@123 (not env-driven). Change the password right after
#     first login.
# ------------------------------------------------------------

DATABASE_URL=postgresql://avnadmin:AVNS_tDFP5ewZavkdt8QkiAO@pg-1c761498-abd471270-8e01.c.aivencloud.com:27964/defaultdb?sslmode=require